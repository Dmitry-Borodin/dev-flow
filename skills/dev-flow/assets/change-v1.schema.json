{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-flow.local/change-v1.schema.json",
  "title": "Dev Flow change manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "workflow_version",
    "revision",
    "id",
    "project",
    "title",
    "kind",
    "risk",
    "lifecycle",
    "current_phase",
    "phases",
    "blockers",
    "provenance"
  ],
  "properties": {
    "contract": {"const": "dev-flow/change/v1"},
    "workflow_version": {"const": "1"},
    "revision": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["feature", "bug", "refactor", "maintenance"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "lifecycle": {"enum": ["active", "blocked", "done", "cancelled", "superseded"]},
    "current_phase": {
      "type": ["string", "null"],
      "enum": ["frame", "discover", "specify", "plan", "implement", "verify", "review", "close", null]
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "discover", "specify", "plan", "implement", "verify", "review", "close"],
      "properties": {
        "frame": {"$ref": "#/$defs/phase"},
        "discover": {"$ref": "#/$defs/phase"},
        "specify": {"$ref": "#/$defs/phase"},
        "plan": {"$ref": "#/$defs/phase"},
        "implement": {"$ref": "#/$defs/phase"},
        "verify": {"$ref": "#/$defs/phase"},
        "review": {"$ref": "#/$defs/phase"},
        "close": {"$ref": "#/$defs/phase"}
      }
    },
    "blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/blocker"}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_inputs", "verified_workspace", "reviewed_workspace"],
      "properties": {
        "plan_inputs": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/digest"}
        },
        "verified_workspace": {
          "oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]
        },
        "reviewed_workspace": {
          "oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "state", "evidence"],
      "properties": {
        "required": {"type": "boolean"},
        "state": {"enum": ["pending", "active", "passed", "skipped"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "message", "status", "opened_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "closed"]},
        "opened_at": {"type": "string", "format": "date-time"},
        "closed_at": {"type": "string", "format": "date-time"},
        "resolution": {"type": "string", "minLength": 1}
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value", "source"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"enum": ["git", "files"]}
      }
    }
  }
}
